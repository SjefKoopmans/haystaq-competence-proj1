# EditorConfig - https://editorconfig.org
# Eén bron van waarheid voor whitespace, zodat een agent-PR geen diff-ruis
# produceert die de echte wijziging verbergt.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,json,css,yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2

[*.md]
# Twee spaties aan het regeleinde is in Markdown een harde regelafbreking.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
