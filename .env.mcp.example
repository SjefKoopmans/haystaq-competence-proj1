# Kopieer dit bestand naar .env.mcp en vul je eigen waarden in.
# .env.mcp staat in .gitignore en wordt nooit gecommit.

# GitHub: CLASSIC token met scope 'repo'.
# Maak aan op https://github.com/settings/tokens/new
# Let op: een fine-grained token werkt niet. De repo staat op een persoonlijk
# account van iemand anders en is daar niet selecteerbaar.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_vervang_dit

# Jira: het e-mailadres waarmee je inlogt op haystaqteam3.atlassian.net
JIRA_USERNAME=voornaam.achternaam@haystaq.nl

# Jira: API-token via
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=ATATT_vervang_dit
