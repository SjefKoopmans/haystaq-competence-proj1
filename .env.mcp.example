# Kopieer dit bestand naar .env.mcp en vul je eigen waarden in.
# .env.mcp staat in .gitignore en wordt nooit gecommit.
#
# Eén bestand voor alle vier de MCP-servers: elke container krijgt het via
# --env-file mee. Zie docs/mcp-setup.md voor de volledige uitleg.

# ---------------------------------------------------------------------------
# 1. GitHub MCP - branches, PR's, checks, comments
# ---------------------------------------------------------------------------
# CLASSIC token met scope 'repo'.
# Maak aan op https://github.com/settings/tokens/new
# Let op: een fine-grained token werkt niet. De repo staat op een persoonlijk
# account van iemand anders en is daar niet selecteerbaar.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_vervang_dit

# ---------------------------------------------------------------------------
# 2. Atlassian MCP - Jira lezen en schrijven
# ---------------------------------------------------------------------------
# Het e-mailadres waarmee je inlogt op haystaqteam3.atlassian.net
JIRA_USERNAME=voornaam.achternaam@haystaq.nl

# API-token via
# https://id.atlassian.com/manage-profile/security/api-tokens
# Voor de onbemande pipeline hoort hier het token van het service-account
# (svc-tijdwijs-agent) te staan, niet je persoonlijke token. Zie
# docs/mcp-setup.md, sectie "Least privilege".
JIRA_API_TOKEN=ATATT_vervang_dit

# ---------------------------------------------------------------------------
# 3. Postgres MCP - schema-introspectie, read-only
# ---------------------------------------------------------------------------
# Gebruik de read-only rol (fase 2.4), niet de applicatiegebruiker. Die rol
# heeft alleen SELECT en toegang tot information_schema, zodat een agent die
# per ongeluk een DELETE formuleert een permission denied krijgt in plaats van
# dataverlies te veroorzaken.
# Draait de database op een andere poort? Pas 5433 aan (zie .env).
DATABASE_URI=postgresql://tijdwijs_ro:tijdwijs_ro@host.docker.internal:5433/tijdwijs

# ---------------------------------------------------------------------------
# 4. TijdWijs Testdata MCP - de toolkit uit opdracht 1
# ---------------------------------------------------------------------------
# Deze mag wél schrijven: hij is er om data te laden. Daarom de gewone
# applicatiegebruiker en niet de read-only rol.
TIJDWIJS_DB_URL=postgresql://tijdwijs:tijdwijs@host.docker.internal:5433/tijdwijs
TIJDWIJS_API_URL=http://host.docker.internal:8081
